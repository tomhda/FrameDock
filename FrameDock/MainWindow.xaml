<Window
    x:Class="FrameDock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameDock">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="*,Auto,Auto,Auto" PreviewKeyDown="RootGrid_KeyDown" PointerEntered="RootGrid_PointerEntered" PointerMoved="RootGrid_PointerMoved" PointerExited="RootGrid_PointerExited" IsTabStop="True" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.Resources>
            <Style x:Key="TransportButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SkipButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="46" />
                <Setter Property="MinWidth" Value="48" />
            </Style>
            <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
                <Setter Property="Width" Value="62" />
                <Setter Property="Height" Value="62" />
                <Setter Property="MinWidth" Value="62" />
            </Style>
            <Style x:Key="MenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,7" />
            </Style>
            <Style x:Key="ToggleMenuFlyoutItemStyle" TargetType="ToggleMenuFlyoutItem">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style x:Key="MenuFlyoutSubItemStyle" TargetType="MenuFlyoutSubItem">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,7" />
            </Style>
        </Grid.Resources>
        <Grid x:Name="VideoRegion" Background="#000000" SizeChanged="VideoRegion_SizeChanged" RightTapped="VideoRegion_RightTapped">
            <SwapChainPanel x:Name="MpvSwapChainPanel" Visibility="Collapsed" />
            <Canvas x:Name="CropOverlayCanvas" Background="Transparent" Visibility="Collapsed"
                    PointerPressed="CropOverlayCanvas_PointerPressed"
                    PointerMoved="CropOverlayCanvas_PointerMoved"
                    PointerReleased="CropOverlayCanvas_PointerReleased"
                    PointerCanceled="CropOverlayCanvas_PointerCanceled"
                    PointerCaptureLost="CropOverlayCanvas_PointerCaptureLost">
                <Rectangle x:Name="CropMaskLeft" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropMaskTop" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropMaskRight" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropMaskBottom" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropSelectionRectangle" Fill="Transparent" Stroke="#4C8BF5" StrokeThickness="2" IsHitTestVisible="False" />
                <Border x:Name="CropHandleTopLeft" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CropHandleTop" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CropHandleTopRight" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CropHandleRight" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CropHandleBottomRight" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CropHandleBottom" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CropHandleBottomLeft" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CropHandleLeft" Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#4C8BF5" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
            </Canvas>
            <Canvas x:Name="ZoomPanCanvas" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False"
                    PointerPressed="ZoomPanCanvas_PointerPressed"
                    PointerMoved="ZoomPanCanvas_PointerMoved"
                    PointerReleased="ZoomPanCanvas_PointerReleased"
                    PointerCanceled="ZoomPanCanvas_PointerCanceled"
                    PointerCaptureLost="ZoomPanCanvas_PointerCaptureLost"
                    ToolTipService.ToolTip="プレビューをドラッグしてズーム位置を調整" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Image Source="ms-appx:///Assets/FrameDock.png" Width="88" Height="88" HorizontalAlignment="Center" AutomationProperties.Name="FrameDock" />
                <TextBlock Text="動画を開くか、ここにドロップ" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" />
                <Button Content="ファイルを開く" Click="OpenButton_Click" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border x:Name="EditorPanel" Grid.Row="1" Padding="12,18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
            <Grid ColumnDefinitions="*,360" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,44,*">
                    <TextBlock Text="編集" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="EditPlayButton" Grid.Column="1" Width="42" Height="42" Padding="0" Click="PlayButton_Click" ToolTipService.ToolTip="再生または一時停止" AutomationProperties.Name="再生または一時停止">
                        <FontIcon x:Name="EditPlayIcon" Glyph="&#xE768;" FontSize="17" />
                    </Button>
                    <Button x:Name="CancelEditButton" Grid.Column="2" Width="36" Height="36" MinWidth="36" Padding="0" Click="CancelEditButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="編集内容を破棄して通常再生に戻る" AutomationProperties.Name="編集内容を破棄して通常再生に戻る">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="64,Auto">
                    <Canvas x:Name="TrimTimelineCanvas" Grid.Row="0" Height="64" MinHeight="64" Background="Transparent"
                            SizeChanged="TrimTimelineCanvas_SizeChanged"
                            PointerPressed="TrimTimelineCanvas_PointerPressed"
                            PointerMoved="TrimTimelineCanvas_PointerMoved"
                            PointerReleased="TrimTimelineCanvas_PointerReleased"
                            PointerCanceled="TrimTimelineCanvas_PointerCanceled"
                            PointerCaptureLost="TrimTimelineCanvas_PointerCaptureLost"
                            AutomationProperties.Name="トリミング範囲と再生位置">
                        <Border x:Name="TrimTimelineBase" Height="52" CornerRadius="5" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" IsHitTestVisible="False">
                            <Canvas x:Name="TrimThumbnailStrip" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="TrimTimelineBefore" Height="52" CornerRadius="5,0,0,5" Background="#AA000000" IsHitTestVisible="False" />
                        <Border x:Name="TrimTimelineSelection" Height="52" Background="#180078D4" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" IsHitTestVisible="False" />
                        <Border x:Name="TrimTimelineAfter" Height="52" CornerRadius="0,5,5,0" Background="#AA000000" IsHitTestVisible="False" />
                        <Border x:Name="TrimStartHandle" Width="20" Height="48" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3" IsHitTestVisible="False" AutomationProperties.Name="切り出し開始位置" />
                        <Border x:Name="TrimEndHandle" Width="20" Height="48" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3" IsHitTestVisible="False" AutomationProperties.Name="切り出し終了位置" />
                        <Border x:Name="TrimPlayheadLine" Width="7" Height="62" CornerRadius="3" Background="#FFFFC000" BorderBrush="#FF141414" BorderThickness="1" IsHitTestVisible="False" AutomationProperties.Name="現在の再生位置" />
                        <Border x:Name="TrimPlayheadKnob" Width="16" Height="16" CornerRadius="8" Background="#FFFFC000" BorderBrush="#FF141414" BorderThickness="2" IsHitTestVisible="False" AutomationProperties.Name="現在位置をドラッグ" />
                    </Canvas>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="8,0">
                        <TextBlock x:Name="TrimStartReadout" Text="開始 00:00" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TrimPlayheadReadout" Grid.Column="1" Text="再生位置 00:00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#FFFFC000" />
                        <TextBlock x:Name="TrimEndReadout" Grid.Column="2" Text="終了 00:00" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="2" Grid.Column="0" Height="78" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom">
                            <NumberBox x:Name="TrimStartBox" Width="86" Header="開始 (秒)" Minimum="0" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ToolTipService.ToolTip="切り出し開始時刻（秒）" />
                            <Button Width="30" Height="32" Click="MarkTrimStartButton_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="現在位置を開始に設定" AutomationProperties.Name="現在の再生位置を開始に設定"><TextBlock Text="[" FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI" /></Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom">
                            <NumberBox x:Name="TrimEndBox" Width="86" Header="終了 (秒)" Minimum="0" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ToolTipService.ToolTip="切り出し終了時刻（秒）" />
                            <Button Width="30" Height="32" Click="MarkTrimEndButton_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="現在位置を終了に設定" AutomationProperties.Name="現在の再生位置を終了に設定"><TextBlock Text="]" FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI" /></Button>
                        </StackPanel>
                        <Rectangle Width="1" Height="30" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="2,0" />
                        <Button x:Name="CropModeButton" Width="36" Height="36" Padding="0" Click="CropModeButton_Click" ToolTipService.ToolTip="8つのハンドルでクロップ範囲を調整" AutomationProperties.Name="クロップ範囲を調整" IsEnabled="False">
                            <StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE7A7;" /><TextBlock x:Name="CropModeButtonText" Text="クロップ" Visibility="Collapsed" /></StackPanel>
                        </Button>
                        <Button x:Name="CropResetButton" Width="32" Height="36" Padding="0" Click="CropResetButton_Click" IsEnabled="False" ToolTipService.ToolTip="クロップを解除" AutomationProperties.Name="クロップを解除">
                            <FontIcon Glyph="&#xE777;" />
                        </Button>
                        <Button x:Name="RotateButton" MinWidth="60" Height="36" Click="RotateButton_Click" ToolTipService.ToolTip="プレビューと書き出しを時計回りに 90 度回転" AutomationProperties.Name="回転">
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE7AD;" /><TextBlock x:Name="RotateButtonText" Text="0°" /></StackPanel>
                        </Button>
                        <Button x:Name="ZoomButton" MinWidth="60" Height="36" ToolTipService.ToolTip="拡大してプレビューをドラッグすると位置を調整。書き出しにも反映" AutomationProperties.Name="編集ズーム">
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE71E;" /><TextBlock x:Name="ZoomFactorText" Text="1×" /></StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <Border Padding="12">
                                        <StackPanel Width="248" Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="ズーム" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ZoomFlyoutReadout" Grid.Column="1" Text="1×" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </Grid>
                                            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" StepFrequency="0.1" SmallChange="0.1" LargeChange="0.5" AutomationProperties.Name="ズーム倍率" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="プレビューをドラッグして位置調整" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Button x:Name="ZoomResetButton" Grid.Column="1" Width="32" Height="32" Padding="0" Click="ZoomResetButton_Click" ToolTipService.ToolTip="1×・中央に戻す" AutomationProperties.Name="ズームを1倍・中央に戻す">
                                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="EditSpeedButton" MinWidth="58" Height="36" ToolTipService.ToolTip="プレビューと書き出しの再生速度" AutomationProperties.Name="編集速度">
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE768;" /><TextBlock x:Name="EditSpeedText" Text="1×" /></StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <ToggleMenuFlyoutItem Text="0.5×" Tag="0.5" Click="EditSpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="0.75×" Tag="0.75" Click="EditSpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="1×" Tag="1" Click="EditSpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="1.25×" Tag="1.25" Click="EditSpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="1.5×" Tag="1.5" Click="EditSpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="2×" Tag="2" Click="EditSpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="4×" Tag="4" Click="EditSpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="CropInfoText" Text="クロップなし" FontSize="11" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" AutomationProperties.Name="クロップサイズ" />
                        <TextBlock x:Name="HdrNoteText" Text="HDR は「高速切り出し（画質維持）」のみ対応" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="160" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Grid.Column="1" Padding="10,4" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <TextBox x:Name="OutputNameBox" Height="32" PlaceholderText="ファイル名" AutomationProperties.Name="出力ファイル名（拡張子を除く）" />
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,104,36,*" ColumnSpacing="8">
                            <TextBlock Text="形式" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="OutputContainerComboBox" Grid.Column="1" Height="34" SelectedIndex="0" ToolTipService.ToolTip="出力形式" AutomationProperties.Name="出力形式">
                                <ComboBoxItem Content="MP4" Tag="Mp4" />
                                <ComboBoxItem Content="MKV" Tag="Mkv" />
                                <ComboBoxItem Content="MOV" Tag="Mov" />
                            </ComboBox>
                            <Button x:Name="ExportOptionsButton" Grid.Column="2" Width="36" Height="34" Padding="0" ToolTipService.ToolTip="書き出しの詳細" AutomationProperties.Name="書き出しの詳細">
                                <FontIcon Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <ToggleMenuFlyoutItem x:Name="ApproximateCopyMenuItem" Text="高速切り出し（画質維持）" IsEnabled="False" ToolTipService.ToolTip="再圧縮せずに保存します。切り出し境界は前後する場合があります。クロップ・回転・ズーム・速度変更とは併用できません。" Style="{StaticResource ToggleMenuFlyoutItemStyle}" AutomationProperties.Name="高速切り出し（画質維持）。境界が前後する場合があり、クロップ・回転・ズーム・速度変更とは併用できません" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ExportButton" Grid.Column="3" Height="34" Padding="8,0" Content="書き出し" Style="{StaticResource AccentButtonStyle}" Click="ExportButton_Click" IsEnabled="False" AutomationProperties.Name="動画を書き出す" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="32,*" ColumnSpacing="6">
                            <Button x:Name="OutputFolderButton" Width="30" Height="28" Padding="0" Click="OutputFolderButton_Click" ToolTipService.ToolTip="保存先フォルダーを選択" AutomationProperties.Name="保存先フォルダーを選択">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            </Button>
                            <TextBlock x:Name="OutputFolderText" Grid.Column="1" Text="元動画と同じフォルダー" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="元動画と同じフォルダー" />
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="EditRangeText" Text="開始と終了を確認してください" FontSize="11" Height="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="ExportProgressBar" Height="4" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="CancelExportButton" Grid.Column="1" Width="28" Height="24" Padding="0" Click="CancelExportButton_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" ToolTipService.ToolTip="書き出しをキャンセル" AutomationProperties.Name="書き出しをキャンセル">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ControlsBorder" Grid.Row="0" VerticalAlignment="Bottom" Padding="12,7" Background="#E61F1F1F" Visibility="Collapsed" PointerEntered="ControlsBorder_PointerEntered" PointerExited="ControlsBorder_PointerExited" GotFocus="ControlsBorder_GotFocus" LostFocus="ControlsBorder_LostFocus">
            <Grid RowDefinitions="40,Auto,Auto" RowSpacing="2">
                <Slider x:Name="TimelineSlider" Grid.Row="0" Height="40" MinHeight="40" Margin="0" Minimum="0" Maximum="1" Value="0" StepFrequency="0.1" IsEnabled="False" AutomationProperties.Name="再生位置" ToolTipService.ToolTip="再生位置" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="OpenButton" Style="{StaticResource TransportButtonStyle}" Click="OpenButton_Click" ToolTipService.ToolTip="動画を開く (Ctrl+O)" AutomationProperties.Name="動画を開く">
                            <FontIcon Glyph="&#xE8E5;" FontSize="18" />
                        </Button>
                        <TextBlock x:Name="TimeText" Text="00:00 / 00:00" VerticalAlignment="Center" MinWidth="108" Margin="4,0,0,0" FontSize="13" AutomationProperties.Name="再生時間" />
                        <TextBlock x:Name="InlineNoticeText" MaxWidth="200" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource SkipButtonStyle}" Click="BackButton_Click" ToolTipService.ToolTip="設定した秒数だけ戻る (←)" AutomationProperties.Name="設定した秒数だけ戻る">
                            <Grid Width="25" Height="25">
                                <Path Data="M19,16 C19,10.8 15.5,6.5 10.5,6.5 C7.4,6.5 5.1,8.1 3.8,10.5 M3.8,10.5 L4,5.5 M3.8,10.5 L8.6,10.1" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock x:Name="BackSkipText" Text="10" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,4,0,0" />
                            </Grid>
                        </Button>
                        <Button x:Name="PreviousFrameButton" Style="{StaticResource TransportButtonStyle}" Click="PreviousFrameButton_Click" ToolTipService.ToolTip="一時停止して前のフレームへ (,)" AutomationProperties.Name="前のフレーム">
                            <Grid ColumnDefinitions="2,Auto" ColumnSpacing="1">
                                <Rectangle Width="1.5" Height="13" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="1" Glyph="&#xE100;" FontSize="15" />
                            </Grid>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButtonStyle}" Click="PlayButton_Click" ToolTipService.ToolTip="再生または一時停止 (Space)" AutomationProperties.Name="再生または一時停止">
                            <Border Width="52" Height="52" CornerRadius="26" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Background="Transparent">
                                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Button>
                        <Button x:Name="NextFrameButton" Style="{StaticResource TransportButtonStyle}" Click="NextFrameButton_Click" ToolTipService.ToolTip="一時停止して次のフレームへ (.)" AutomationProperties.Name="次のフレーム">
                            <Grid ColumnDefinitions="Auto,2" ColumnSpacing="1">
                                <FontIcon Glyph="&#xE101;" FontSize="15" />
                                <Rectangle Grid.Column="1" Width="1.5" Height="13" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button x:Name="ForwardButton" Style="{StaticResource SkipButtonStyle}" Click="ForwardButton_Click" ToolTipService.ToolTip="設定した秒数だけ進む (→)" AutomationProperties.Name="設定した秒数だけ進む">
                            <Grid Width="25" Height="25">
                                <Path Data="M5,16 C5,10.8 8.5,6.5 13.5,6.5 C16.6,6.5 18.9,8.1 20.2,10.5 M20.2,10.5 L20,5.5 M20.2,10.5 L15.4,10.1" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock x:Name="ForwardSkipText" Text="10" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,4,0,0" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource TransportButtonStyle}" Click="MuteButton_Click" ToolTipService.ToolTip="ミュートの切り替え" AutomationProperties.Name="ミュート">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="18" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="92" Minimum="0" Maximum="100" Value="75" VerticalAlignment="Center" AutomationProperties.Name="音量" ToolTipService.ToolTip="音量" />
                        <Button x:Name="SaveFrameButton" Style="{StaticResource TransportButtonStyle}" Click="SaveFrameButton_Click" ToolTipService.ToolTip="現在のフレームをピクチャ\FrameDock に保存 (Ctrl+S)" AutomationProperties.Name="フレーム画像を保存">
                            <FontIcon Glyph="&#xE722;" FontSize="18" />
                        </Button>
                        <Button x:Name="FullscreenButton" Style="{StaticResource TransportButtonStyle}" Click="FullscreenButton_Click" ToolTipService.ToolTip="全画面表示 (F)" AutomationProperties.Name="全画面表示">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="18" />
                        </Button>
                        <Button x:Name="OverflowButton" Style="{StaticResource TransportButtonStyle}" ToolTipService.ToolTip="編集とその他の操作" AutomationProperties.Name="編集とその他の操作">
                        <FontIcon Glyph="&#xE712;" FontSize="17" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="フレームをコピー" Click="CopyFrameButton_Click" Style="{StaticResource MenuFlyoutItemStyle}" AutomationProperties.Name="表示中のフレームをコピー">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="編集…" Click="EditButton_Click" Style="{StaticResource MenuFlyoutItemStyle}" AutomationProperties.Name="トリム、クロップ、書き出しを編集">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="DisplayModeMenuItem" Text="表示モード" Style="{StaticResource MenuFlyoutSubItemStyle}">
                                    <ToggleMenuFlyoutItem x:Name="AlwaysVisibleModeItem" Text="常時表示（動画領域を確保）" Tag="AlwaysVisible" Click="DisplayModeMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem x:Name="MaximizedOverlayModeItem" Text="最大化（タスクバー表示）" Tag="MaximizedOverlay" Click="DisplayModeMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem x:Name="FullscreenModeItem" Text="全画面表示" Tag="Fullscreen" Click="DisplayModeMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem x:Name="SpeedMenuItem" Text="再生速度" ToolTipService.ToolTip="再生速度" Style="{StaticResource MenuFlyoutSubItemStyle}">
                                    <ToggleMenuFlyoutItem Text="0.5×" Tag="0.5" Click="SpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="0.75×" Tag="0.75" Click="SpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="1×" Tag="1" Click="SpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="1.25×" Tag="1.25" Click="SpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="1.5×" Tag="1.5" Click="SpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="2×" Tag="2" Click="SpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                    <ToggleMenuFlyoutItem Text="4×" Tag="4" Click="SpeedMenuItem_Click" Style="{StaticResource ToggleMenuFlyoutItemStyle}" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="設定…" Click="SettingsButton_Click" Style="{StaticResource MenuFlyoutItemStyle}" AutomationProperties.Name="再生設定">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <InfoBar x:Name="NotificationBar" Grid.Row="3" Margin="12,4,12,8" Visibility="Collapsed" IsOpen="False" IsClosable="True" Severity="Error" Title="エラー" />
    </Grid>
</Window>

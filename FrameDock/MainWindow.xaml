<Window
    x:Class="FrameDock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameDock">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="*,Auto,Auto" KeyDown="RootGrid_KeyDown" IsTabStop="True" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.Resources>
            <Style x:Key="TransportButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid x:Name="VideoRegion" Background="#000000" SizeChanged="VideoRegion_SizeChanged" RightTapped="VideoRegion_RightTapped">
            <SwapChainPanel x:Name="MpvSwapChainPanel" Visibility="Collapsed" />
            <Canvas x:Name="CropOverlayCanvas" Background="Transparent" Visibility="Collapsed"
                    PointerPressed="CropOverlayCanvas_PointerPressed"
                    PointerMoved="CropOverlayCanvas_PointerMoved"
                    PointerReleased="CropOverlayCanvas_PointerReleased"
                    PointerCanceled="CropOverlayCanvas_PointerCanceled">
                <Rectangle x:Name="CropMaskLeft" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropMaskTop" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropMaskRight" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropMaskBottom" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropSelectionRectangle" Fill="Transparent" Stroke="#4C8BF5" StrokeThickness="2" IsHitTestVisible="False" />
            </Canvas>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <FontIcon Glyph="&#xE714;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="動画を開くか、ここにドロップ" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" />
                <Button Content="ファイルを開く" Click="OpenButton_Click" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border x:Name="EditorPanel" Grid.Row="1" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <TextBlock Text="切り出し" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <NumberBox x:Name="TrimStartBox" Grid.Column="1" Width="104" Header="開始 (秒)" Minimum="0" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                    <Button Grid.Column="2" Content="現在位置" Click="MarkTrimStartButton_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="再生位置を開始に設定" />
                    <TextBlock Grid.Column="3" Text="から" VerticalAlignment="Center" />
                    <NumberBox x:Name="TrimEndBox" Grid.Column="4" Width="104" Header="終了 (秒)" Minimum="0" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                    <Button Grid.Column="5" Content="現在位置" Click="MarkTrimEndButton_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="再生位置を終了に設定" />
                    <CheckBox x:Name="ApproximateCopyCheckBox" Grid.Column="6" Grid.ColumnSpan="3" Content="高速コピー（キーフレーム位置で前後する場合があります）" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="HdrNoteText" Grid.Column="9" Grid.ColumnSpan="3" Text="HDR 動画は正確な再エンコードに対応していません" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Button x:Name="CropModeButton" Content="クロップ範囲を選択" Click="CropModeButton_Click" ToolTipService.ToolTip="動画上をドラッグして切り抜く範囲を選択" />
                    <Button x:Name="CropResetButton" Grid.Column="1" Content="全体を使う" Click="CropResetButton_Click" IsEnabled="False" />
                    <TextBlock x:Name="CropInfoText" Grid.Column="2" Text="クロップなし" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="OutputFolderButton" Grid.Column="3" Content="保存先…" Click="OutputFolderButton_Click" />
                    <TextBlock x:Name="OutputFolderText" Grid.Column="4" Text="元動画と同じフォルダー" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,220,Auto" ColumnSpacing="8">
                    <TextBox x:Name="OutputNameBox" Width="280" Header="出力ファイル名" PlaceholderText="動画名-clip" />
                    <TextBlock x:Name="EditRangeText" Grid.Column="1" Text="開始と終了を確認してください" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ExportButton" Grid.Column="2" Content="MP4 に書き出す" Click="ExportButton_Click" IsEnabled="False" />
                    <ProgressBar x:Name="ExportProgressBar" Grid.Column="3" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Button x:Name="CancelExportButton" Grid.Column="5" Content="キャンセル" Click="CancelExportButton_Click" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="12,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowDefinitions="18,Auto,Auto" RowSpacing="1">
                <Slider x:Name="TimelineSlider" Grid.Row="0" Height="18" MinHeight="18" Margin="0" Minimum="0" Maximum="1" Value="0" IsEnabled="False" PointerPressed="TimelineSlider_PointerPressed" PointerReleased="TimelineSlider_PointerReleased" AutomationProperties.Name="再生位置" ToolTipService.ToolTip="再生位置" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                    <Button x:Name="OpenButton" Style="{StaticResource TransportButtonStyle}" Click="OpenButton_Click" ToolTipService.ToolTip="動画を開く (Ctrl+O)" AutomationProperties.Name="動画を開く">
                        <FontIcon Glyph="&#xE8E5;" FontSize="17" />
                    </Button>
                    <Button x:Name="BackButton" Grid.Column="2" Style="{StaticResource TransportButtonStyle}" Click="BackButton_Click" ToolTipService.ToolTip="設定した秒数だけ戻る (←)" AutomationProperties.Name="設定した秒数だけ戻る">
                        <TextBlock x:Name="BackSkipText" Text="−10" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="PreviousFrameButton" Grid.Column="3" Style="{StaticResource TransportButtonStyle}" Click="PreviousFrameButton_Click" ToolTipService.ToolTip="一時停止して前のフレームへ (,)" AutomationProperties.Name="前のフレーム">
                        <Grid ColumnDefinitions="2,Auto" ColumnSpacing="1">
                            <Rectangle Width="1.5" Height="12" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="&#xE100;" FontSize="14" />
                        </Grid>
                    </Button>
                    <Button x:Name="PlayButton" Grid.Column="4" Style="{StaticResource TransportButtonStyle}" Click="PlayButton_Click" ToolTipService.ToolTip="再生または一時停止 (Space)" AutomationProperties.Name="再生または一時停止">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="17" />
                    </Button>
                    <Button x:Name="NextFrameButton" Grid.Column="5" Style="{StaticResource TransportButtonStyle}" Click="NextFrameButton_Click" ToolTipService.ToolTip="一時停止して次のフレームへ (.)" AutomationProperties.Name="次のフレーム">
                        <Grid ColumnDefinitions="Auto,2" ColumnSpacing="1">
                            <FontIcon Glyph="&#xE101;" FontSize="14" />
                            <Rectangle Grid.Column="1" Width="1.5" Height="12" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="ForwardButton" Grid.Column="6" Style="{StaticResource TransportButtonStyle}" Click="ForwardButton_Click" ToolTipService.ToolTip="設定した秒数だけ進む (→)" AutomationProperties.Name="設定した秒数だけ進む">
                        <TextBlock x:Name="ForwardSkipText" Text="+10" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <TextBlock x:Name="TimeText" Grid.Column="7" Text="00:00 / 00:00" VerticalAlignment="Center" MinWidth="108" Margin="8,0,10,0" AutomationProperties.Name="再生時間" />
                    <TextBlock x:Name="InlineNoticeText" Grid.Column="9" MaxWidth="260" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <Button x:Name="MuteButton" Grid.Column="10" Style="{StaticResource TransportButtonStyle}" Click="MuteButton_Click" ToolTipService.ToolTip="ミュートの切り替え" AutomationProperties.Name="ミュート">
                        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="17" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="11" Width="92" Minimum="0" Maximum="100" Value="75" VerticalAlignment="Center" AutomationProperties.Name="音量" ToolTipService.ToolTip="音量" />
                    <Button x:Name="SaveFrameButton" Grid.Column="12" Style="{StaticResource TransportButtonStyle}" Click="SaveFrameButton_Click" ToolTipService.ToolTip="現在のフレームを Pictures\FrameDock に保存 (Ctrl+S)" AutomationProperties.Name="フレーム画像を保存">
                        <FontIcon Glyph="&#xE722;" FontSize="17" />
                    </Button>
                    <Button x:Name="FullscreenButton" Grid.Column="13" Style="{StaticResource TransportButtonStyle}" Click="FullscreenButton_Click" ToolTipService.ToolTip="全画面表示 (F)" AutomationProperties.Name="全画面表示">
                        <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="17" />
                    </Button>
                    <Button x:Name="OverflowButton" Grid.Column="14" Style="{StaticResource TransportButtonStyle}" ToolTipService.ToolTip="編集とその他の操作" AutomationProperties.Name="編集とその他の操作">
                        <FontIcon Glyph="&#xE712;" FontSize="17" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="フレームをコピー" Click="CopyFrameButton_Click" AutomationProperties.Name="表示中のフレームをコピー">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="編集…" Click="EditButton_Click" AutomationProperties.Name="トリム、クロップ、書き出しを編集">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="SpeedMenuItem" Text="再生速度" ToolTipService.ToolTip="再生速度">
                                    <ToggleMenuFlyoutItem Text="0.5×" Tag="0.5" Click="SpeedMenuItem_Click" />
                                    <ToggleMenuFlyoutItem Text="0.75×" Tag="0.75" Click="SpeedMenuItem_Click" />
                                    <ToggleMenuFlyoutItem Text="1×" Tag="1" Click="SpeedMenuItem_Click" />
                                    <ToggleMenuFlyoutItem Text="1.25×" Tag="1.25" Click="SpeedMenuItem_Click" />
                                    <ToggleMenuFlyoutItem Text="1.5×" Tag="1.5" Click="SpeedMenuItem_Click" />
                                    <ToggleMenuFlyoutItem Text="2×" Tag="2" Click="SpeedMenuItem_Click" />
                                    <ToggleMenuFlyoutItem Text="4×" Tag="4" Click="SpeedMenuItem_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="設定…" Click="SettingsButton_Click" AutomationProperties.Name="再生設定">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <InfoBar x:Name="NotificationBar" Grid.Row="2" Margin="0,2,0,0" IsOpen="False" IsClosable="True" Severity="Error" Title="エラー" />
            </Grid>
        </Border>
    </Grid>
</Window>
